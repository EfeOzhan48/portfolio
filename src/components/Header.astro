---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconUnderline from "@/assets/icons/IconUnderline.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import LinkButton from "./LinkButton.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class="app-layout flex flex-col items-center justify-between sm:flex-row"
>
  <div
    class="border-border bg-background relative flex w-full items-baseline justify-between border-b py-4 sm:items-center sm:py-6"
  >
    <!-- Terminal Logo -->
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="whitespace-nowrap font-mono text-lg font-bold tracking-wider text-accent hover:text-[var(--accent-purple,#c084fc)] transition-colors inline-flex items-center gap-1.5"
    >
      <span class="text-[var(--accent-purple,#c084fc)] font-extrabold">&gt;_</span>
      <span>efeozhan<span class="opacity-60 text-xs font-normal">.dev</span></span>
    </a>

    <nav
      id="nav-menu"
      class="flex w-full flex-col items-center sm:ms-2 sm:flex-row sm:justify-end sm:space-x-4 sm:py-0"
    >
      <button
        id="menu-btn"
        class="focus-outline self-end p-2 sm:hidden hover:text-[var(--accent-purple,#c084fc)]"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>

      <ul
        id="menu-items"
        class="[&>li>a]:hover:text-[var(--accent-purple,#c084fc)] mt-4 hidden w-44 grid-cols-2 place-content-center gap-2 sm:mt-0 sm:flex sm:w-auto sm:gap-x-5 sm:gap-y-0 sm:[&>li]:h-8 [&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-medium sm:[&>li>a]:px-2 sm:[&>li>a]:py-1"
      >
        <!-- 1. Projects -->
        <li class="col-span-2">
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={{ "active-nav": isActive("/posts") }}
            data-i18n-key="nav_projects"
          >
            Projects
          </a>
        </li>

        <!-- 2. Thoughts -->
        <li class="col-span-2">
          <a
            href={getRelativeLocaleUrl(locale, "thoughts")}
            class:list={{ "active-nav": isActive("/thoughts") }}
            data-i18n-key="nav_thoughts"
          >
            Thoughts
          </a>
        </li>

        <!-- 3. About -->
        <li class="col-span-2">
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={{ "active-nav": isActive("/about") }}
            data-i18n-key="nav_about"
          >
            {t.nav.about}
          </a>
        </li>

        {
          features.showArchives && (
            <li class="col-span-2">
              <LinkButton
                href={getRelativeLocaleUrl(locale, "archives")}
                class:list={[
                  "focus-outline flex size-full justify-center p-3 hover:text-[var(--accent-purple,#c084fc)] sm:relative sm:size-8 sm:p-0",
                  { "active-nav": isActive("/archives") },
                ]}
                title={t.nav.archives}
                aria-label={t.nav.archives}
              >
                <IconArchive class="hidden sm:absolute sm:top-1/2 sm:left-1/2 sm:block sm:size-6 sm:-translate-x-1/2 sm:-translate-y-1/2" />
                <span class="sm:sr-only">{t.nav.archives}</span>
                {isActive("/archives") && (
                  <IconUnderline
                    aria-hidden="true"
                    class="scale-125 max-sm:hidden sm:absolute sm:bottom-0 sm:w-6"
                  />
                )}
              </LinkButton>
            </li>
          )
        }
        {
          features.search !== false && (
            <li class="col-span-1 flex items-center justify-center">
              <LinkButton
                href={getRelativeLocaleUrl(locale, "search")}
                class:list={["focus-outline relative size-8 hover:text-[var(--accent-purple,#c084fc)]"]}
                title={t.nav.search}
                aria-label={t.nav.search}
              >
                <IconSearch class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2" />
                <span class="sr-only">{t.nav.search}</span>
                {isActive("/search") && (
                  <IconUnderline
                    aria-hidden="true"
                    class="absolute bottom-0 w-6 scale-125 max-sm:inset-s-2"
                  />
                )}
              </LinkButton>
            </li>
          )
        }
        {
          features.lightAndDarkMode && (
            <li class="col-span-1 flex items-center justify-center">
              <button
                id="theme-btn"
                class="focus-outline hover:[&>svg]:stroke-[var(--accent-purple,#c084fc)] hover:[&>svg]:text-[var(--accent-purple,#c084fc)] relative size-12 p-4 sm:size-8"
                title={t.a11y.toggleTheme}
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="absolute top-[50%] left-[50%] translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute top-[50%] left-[50%] translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            </li>
          )
        }

        <!-- Modern Sliding Red/Orange Switcher: ENG / TR -->
        <li class="col-span-2 flex items-center justify-center sm:col-span-1">
          <div class="relative flex items-center rounded-full bg-neutral-200/90 p-0.5 dark:bg-neutral-800/90 border border-neutral-300 dark:border-neutral-700 shadow-inner">
            <div id="lang-slider" class="absolute top-0.5 left-0.5 h-[calc(100%-4px)] w-[34px] rounded-full bg-gradient-to-r from-red-600 to-orange-500 shadow transition-transform duration-200 ease-out"></div>
            
            <button
              id="btn-lang-en"
              type="button"
              class="relative z-10 w-[34px] py-0.5 text-center font-mono text-[11px] font-bold transition-colors duration-150 cursor-pointer select-none"
            >
              ENG
            </button>
            <button
              id="btn-lang-tr"
              type="button"
              class="relative z-10 w-[34px] py-0.5 text-center font-mono text-[11px] font-bold transition-colors duration-150 cursor-pointer select-none"
            >
              TR
            </button>
          </div>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? openLabel : closeLabel);

      menuItems.classList.toggle("hidden");
      menuItems.classList.toggle("grid");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>

<script is:inline>
  // Kapsamlı İçerik Çeviri Veritabanı
  const EN_TO_TR_MAP = {
    // Navigasyon & Arayüz
    "Projects": "Projeler",
    "Thoughts": "Düşünceler",
    "About": "Hakkımda",
    "Search": "Ara",
    "Archives": "Arşiv",
    "Recent Posts": "Son Projeler",
    "Featured": "Öne Çıkanlar",
    "All Posts": "Tüm Projeler",
    "Table of contents": "İçindekiler",
    "Back to Top": "Yukarı Dön",
    "Share this post on:": "Yazıyı paylaş:",

    // Post Detayları & Case Study Başlıkları
    "Project Status: Prototype / Architectural Case Study (Discontinued)": "Proje Durumu: Prototip / Mimari Vaka İncelemesi (Durduruldu)",
    "Project Status: Early Concept / Product Blueprint (Archived)": "Proje Durumu: Erken Konsept / Ürün Taslağı (Arşivlendi)",
    "Project Status: Architectural Prototype / Archived Rails Application": "Proje Durumu: Mimari Prototip / Arşivlenmiş Rails Uygulaması",
    
    "Architectural Showcase": "Mimari Görseller & Arayüz",
    "Technical Stack & Architecture": "Teknik Mimari ve Altyapı",
    "Technical Stack & Full-Stack Architecture": "Teknik Mimari ve Full-Stack Altyapı",
    "Backend API Architecture (Next.js 14)": "Backend API Mimarisi (Next.js 14)",
    "Key Features & Value Proposition": "Güçlü Yönler ve Değer Önerisi",
    "Core Features & Value Proposition": "Temel Özellikler ve Değer Önerisi",
    "The Workflow Concept": "İş Akışı Konsepti",
    "Core Product Workflow": "Temel Ürün İş Akışı",
    "Critical Product Post-Mortem & Bottlenecks": "Kritik Ürün Analizi ve Pazarın Tıkandığı Noktalar",
    "Product Post-Mortem & Strategic Pauses": "Ürün Analizi ve Durdurulma Sebepleri",
    "Why Development Was Paused": "Geliştirmenin Durdurulma Sebepleri",
    "Key Learnings": "Kazanılan Deneyimler",
    "Source Code & Inquiries": "Kaynak Kodlar ve İletişim",
    "Project Notes & Inquiries": "Proje Notları ve İletişim",

    // YTAssist AI Çevirileri
    "is a browser extension and micro-SaaS prototype engineered to integrate directly into the YouTube Studio dashboard. Its core purpose was to eliminate workflow context switching by providing creators with high-CTR video titles, 30-second retention hooks, descriptions, and thumbnail prompts right where they upload.":
      "doğrudan YouTube Studio kontrol paneline entegre olacak şekilde tasarlanmış bir tarayıcı eklentisi ve mikro-SaaS prototipidir. Temel amacı, içerik üreticilerinin sekme değiştirmeden video yükledikleri ekranda yüksek tıklama oranına (CTR) sahip başlıklar, ilk 30 saniyelik kanca metinleri, SEO açıklamaları ve küçük resim istemleri üretmelerini sağlamaktı.",

    "Zero Context Switching: Native DOM injection within YouTube Studio eliminates the need to switch tabs or open separate AI platforms.":
      "Sıfır Sekme Değişimi: YouTube Studio içine doğrudan DOM entegrasyonu sayesinde harici sekmeler veya bağımsız yapay zeka araçları açma ihtiyacını ortadan kaldırır.",

    "Micro-Subscription SaaS Model: Configured for low-friction recurring monetization ($0.99/mo) backed by automated Lemon Squeezy billing.":
      "Mikro-Abonelik SaaS Modeli: Lemon Squeezy otomatik faturalandırma altyapısıyla desteklenen, düşük sürtünmeli aylık 0.99$ abonelik modeli.",

    "Freemium Quota Management: Provided 5 free daily generation credits tracked via extension storage.":
      "Freemium Kota Yönetimi: Eklenti hafızası üzerinden takip edilen günlük 5 adet ücretsiz üretim hakkı sunar.",

    "Focused Prompt Engineering: Purpose-built system prompts tailored specifically for YouTube CTR, retention hooks, and search indexing.":
      "Özelleştirilmiş İstem (Prompt) Mühendisliği: Genel yapay zeka çıktıları yerine özellikle YouTube tıklanma oranları, izleyici tutma metinleri ve SEO için optimize edilmiş şablonlar kullanır.",

    // gmAI Çevirileri
    "is a productivity-focused web application engineered to remove the friction of professional email communication. The platform allows users to input unformatted, shorthand thoughts without worrying about grammar or tone, transforming them into structured, recipient-tailored drafts with mandatory pre-send approval.":
      "profesyonel e-posta iletişimindeki sürtünmeyi ortadan kaldırmak için tasarlanmış, üretkenlik odaklı bir web uygulamasıdır. Platform, kullanıcıların dil bilgisi veya üslup kaygısı gütmeden ham düşüncelerini girmelerine olanak tanır; bu girdileri alıcının rolüne göre uyarlanmış profesyonel taslaklara dönüştürür ve kullanıcı onayıyla gönderir.",

    "Zero Cognitive Overhead: Users don't need to craft polite openers or correct typos; they just dump bullet points or raw text.":
      "Sıfır Bilişsel Yük: Kullanıcıların resmi hitaplar veya imla kuralları için vakit harcamasına gerek kalmaz; sadece ham notlarını veya maddelerini yazmaları yeterlidir.",

    "Intent & Recipient Context Mapping: Dynamic prompt templates that adapt based on the recipient's role (e.g., Academic Professor, Enterprise Client, Team Member).":
      "Alıcı Rolü ve Bağlam Eşleme: Alıcının unvanına (ör. Akademik Danışman, Kurumsal Müşteri, Ekip Arkadaşı) göre hitap dilini otomatik uyarlayan dinamik prompt şablonları.",

    "Human-in-the-Loop Safety Gate: Mandatory pre-send preview ensuring the user retains 100% control before any email is dispatched.":
      "Kullanıcı Kontrol Kapısı: E-posta gönderilmeden önce zorunlu önizleme sunarak yapay zekanın kontrolsüz işlem yapmasını engeller ve tam kullanıcı denetimi sağlar."
  };

  // Ters Çeviri Haritası (TR -> EN)
  const TR_TO_EN_MAP = {};
  for (const [en, tr] of Object.entries(EN_TO_TR_MAP)) {
    TR_TO_EN_MAP[tr] = en;
  }

  function updateSliderVisual(lang) {
    const slider = document.getElementById("lang-slider");
    const btnEn = document.getElementById("btn-lang-en");
    const btnTr = document.getElementById("btn-lang-tr");
    if (!slider || !btnEn || !btnTr) return;

    if (lang === "tr") {
      slider.style.transform = "translateX(34px)";
      btnTr.classList.add("text-white");
      btnTr.classList.remove("text-neutral-500", "dark:text-neutral-400");
      btnEn.classList.remove("text-white");
      btnEn.classList.add("text-neutral-500", "dark:text-neutral-400");
    } else {
      slider.style.transform = "translateX(0px)";
      btnEn.classList.add("text-white");
      btnEn.classList.remove("text-neutral-500", "dark:text-neutral-400");
      btnTr.classList.remove("text-white");
      btnTr.classList.add("text-neutral-500", "dark:text-neutral-400");
    }
  }

  function translatePageDOM(lang) {
    const isTr = lang === "tr";
    const map = isTr ? EN_TO_TR_MAP : TR_TO_EN_MAP;

    // Sayfadaki tüm başlık, paragraf, liste ve buton metinlerini tara
    const elements = document.querySelectorAll(
      "h1, h2, h3, h4, p, li, blockquote, figcaption, [data-i18n-key]"
    );

    elements.forEach(el => {
      // Kod blokları veya dil butonunu atla
      if (el.closest("pre") || el.closest("code") || el.closest("#lang-slider") || el.id?.startsWith("btn-lang")) {
        return;
      }

      const text = el.textContent?.trim();
      if (!text) return;

      // Tam eşleşme kontrolü
      if (map[text]) {
        el.textContent = map[text];
        return;
      }

      // Paragraf içi kısmi cümle eşleştirmeleri
      for (const [source, target] of Object.entries(map)) {
        if (text.includes(source)) {
          el.innerHTML = el.innerHTML.replace(source, target);
        }
      }
    });
  }

  function setAppLanguage(lang) {
    localStorage.setItem("portfolio_lang", lang);
    updateSliderVisual(lang);
    translatePageDOM(lang);
  }

  function initLanguageEngine() {
    const savedLang = localStorage.getItem("portfolio_lang") || "en";
    updateSliderVisual(savedLang);
    if (savedLang === "tr") {
      translatePageDOM("tr");
    }

    const btnEn = document.getElementById("btn-lang-en");
    const btnTr = document.getElementById("btn-lang-tr");

    if (btnEn) {
      btnEn.onclick = (e) => {
        e.preventDefault();
        setAppLanguage("en");
      };
    }

    if (btnTr) {
      btnTr.onclick = (e) => {
        e.preventDefault();
        setAppLanguage("tr");
      };
    }
  }

  // İlk yüklemede ve Astro SPA sayfa geçişlerinde anında çalıştır
  initLanguageEngine();
  document.addEventListener("astro:after-swap", initLanguageEngine);
  document.addEventListener("astro:page-load", initLanguageEngine);
</script>