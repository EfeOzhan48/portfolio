---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconUnderline from "@/assets/icons/IconUnderline.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import LinkButton from "./LinkButton.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class="app-layout flex flex-col items-center justify-between sm:flex-row"
>
  <div
    class="border-border bg-background relative flex w-full items-baseline justify-between border-b py-4 sm:items-center sm:py-6"
  >
    <!-- Terminal Logo -->
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="whitespace-nowrap font-mono text-lg font-bold tracking-wider text-accent hover:text-[var(--accent-purple,#c084fc)] transition-colors inline-flex items-center gap-1.5"
    >
      <span class="text-[var(--accent-purple,#c084fc)] font-extrabold">&gt;_</span>
      <span>efeozhan<span class="opacity-60 text-xs font-normal">.dev</span></span>
    </a>

    <nav
      id="nav-menu"
      class="flex w-full flex-col items-center sm:ms-2 sm:flex-row sm:justify-end sm:space-x-4 sm:py-0"
    >
      <button
        id="menu-btn"
        class="focus-outline self-end p-2 sm:hidden hover:text-[var(--accent-purple,#c084fc)]"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>

      <ul
        id="menu-items"
        class="[&>li>a]:hover:text-[var(--accent-purple,#c084fc)] mt-4 hidden w-44 grid-cols-2 place-content-center gap-2 sm:mt-0 sm:flex sm:w-auto sm:gap-x-5 sm:gap-y-0 sm:[&>li]:h-8 [&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-medium sm:[&>li>a]:px-2 sm:[&>li>a]:py-1"
      >
        <!-- 1. Projects -->
        <li class="col-span-2">
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={{ "active-nav": isActive("/posts") }}
            data-i18n-nav="projects"
          >
            Projects
          </a>
        </li>

        <!-- 2. Thoughts -->
        <li class="col-span-2">
          <a
            href={getRelativeLocaleUrl(locale, "thoughts")}
            class:list={{ "active-nav": isActive("/thoughts") }}
            data-i18n-nav="thoughts"
          >
            Thoughts
          </a>
        </li>

        <!-- 3. About -->
        <li class="col-span-2">
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={{ "active-nav": isActive("/about") }}
            data-i18n-nav="about"
          >
            {t.nav.about}
          </a>
        </li>

        {
          features.showArchives && (
            <li class="col-span-2">
              <LinkButton
                href={getRelativeLocaleUrl(locale, "archives")}
                class:list={[
                  "focus-outline flex size-full justify-center p-3 hover:text-[var(--accent-purple,#c084fc)] sm:relative sm:size-8 sm:p-0",
                  { "active-nav": isActive("/archives") },
                ]}
                title={t.nav.archives}
                aria-label={t.nav.archives}
              >
                <IconArchive class="hidden sm:absolute sm:top-1/2 sm:left-1/2 sm:block sm:size-6 sm:-translate-x-1/2 sm:-translate-y-1/2" />
                <span class="sm:sr-only">{t.nav.archives}</span>
                {isActive("/archives") && (
                  <IconUnderline
                    aria-hidden="true"
                    class="scale-125 max-sm:hidden sm:absolute sm:bottom-0 sm:w-6"
                  />
                )}
              </LinkButton>
            </li>
          )
        }
        {
          features.search !== false && (
            <li class="col-span-1 flex items-center justify-center">
              <LinkButton
                href={getRelativeLocaleUrl(locale, "search")}
                class:list={["focus-outline relative size-8 hover:text-[var(--accent-purple,#c084fc)]"]}
                title={t.nav.search}
                aria-label={t.nav.search}
              >
                <IconSearch class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2" />
                <span class="sr-only">{t.nav.search}</span>
                {isActive("/search") && (
                  <IconUnderline
                    aria-hidden="true"
                    class="absolute bottom-0 w-6 scale-125 max-sm:inset-s-2"
                  />
                )}
              </LinkButton>
            </li>
          )
        }
        {
          features.lightAndDarkMode && (
            <li class="col-span-1 flex items-center justify-center">
              <button
                id="theme-btn"
                class="focus-outline hover:[&>svg]:stroke-[var(--accent-purple,#c084fc)] hover:[&>svg]:text-[var(--accent-purple,#c084fc)] relative size-12 p-4 sm:size-8"
                title={t.a11y.toggleTheme}
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="absolute top-[50%] left-[50%] translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute top-[50%] left-[50%] translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            </li>
          )
        }

        <!-- Ultra-Smooth Sliding Pill Switcher: ENG / TR -->
        <li class="col-span-2 flex items-center justify-center sm:col-span-1">
          <div class="relative flex items-center rounded-full bg-neutral-200/90 p-0.5 dark:bg-neutral-800/90 border border-neutral-300 dark:border-neutral-700 shadow-inner">
            <div id="lang-slider" class="absolute top-0.5 left-0.5 h-[calc(100%-4px)] w-[34px] rounded-full bg-gradient-to-r from-red-600 to-orange-500 shadow transition-transform duration-200 ease-out"></div>
            
            <button
              id="btn-lang-en"
              type="button"
              class="relative z-10 w-[34px] py-0.5 text-center font-mono text-[11px] font-bold transition-colors duration-150 cursor-pointer select-none"
            >
              ENG
            </button>
            <button
              id="btn-lang-tr"
              type="button"
              class="relative z-10 w-[34px] py-0.5 text-center font-mono text-[11px] font-bold transition-colors duration-150 cursor-pointer select-none"
            >
              TR
            </button>
          </div>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? openLabel : closeLabel);

      menuItems.classList.toggle("hidden");
      menuItems.classList.toggle("grid");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>

<script is:inline>
  // Sözlük (Navigasyon, başlıklar ve genel metinler)
  const DICT = {
    en: {
      "projects": "Projects",
      "thoughts": "Thoughts",
      "about": "About",
      "featured": "Featured",
      "recent": "Recent Posts",
      "all_posts": "All Posts"
    },
    tr: {
      "projects": "Projeler",
      "thoughts": "Düşünceler",
      "about": "Hakkımda",
      "featured": "Öne Çıkanlar",
      "recent": "Son Yazılar",
      "all_posts": "Tüm Projeler"
    }
  };

  function updateSliderVisual(lang) {
    const slider = document.getElementById("lang-slider");
    const btnEn = document.getElementById("btn-lang-en");
    const btnTr = document.getElementById("btn-lang-tr");
    if (!slider || !btnEn || !btnTr) return;

    if (lang === "tr") {
      slider.style.transform = "translateX(34px)";
      btnTr.classList.add("text-white");
      btnTr.classList.remove("text-neutral-500", "dark:text-neutral-400");
      btnEn.classList.remove("text-white");
      btnEn.classList.add("text-neutral-500", "dark:text-neutral-400");
    } else {
      slider.style.transform = "translateX(0px)";
      btnEn.classList.add("text-white");
      btnEn.classList.remove("text-neutral-500", "dark:text-neutral-400");
      btnTr.classList.remove("text-white");
      btnTr.classList.add("text-neutral-500", "dark:text-neutral-400");
    }
  }

  function applyDOMTranslations(lang) {
    const texts = DICT[lang] || DICT.en;
    
    // Menü bağlantılarını anında güncelle
    document.querySelectorAll("[data-i18n-nav]").forEach((el) => {
      const key = el.getAttribute("data-i18n-nav");
      if (texts[key]) el.textContent = texts[key];
    });

    // Sayfa üzerindeki genel başlıkları anında güncelle
    document.querySelectorAll("h2, h3, span, a").forEach((el) => {
      const trimmed = el.textContent?.trim();
      if (lang === "tr") {
        if (trimmed === "Recent Posts") el.textContent = "Son Projeler";
        if (trimmed === "Featured") el.textContent = "Öne Çıkanlar";
        if (trimmed === "All Posts") el.textContent = "Tüm Yazılar";
        if (trimmed === "Search") el.textContent = "Ara";
      } else {
        if (trimmed === "Son Projeler") el.textContent = "Recent Posts";
        if (trimmed === "Öne Çıkanlar") el.textContent = "Featured";
        if (trimmed === "Tüm Yazılar") el.textContent = "All Posts";
        if (trimmed === "Ara") el.textContent = "Search";
      }
    });
  }

  function setLanguage(lang) {
    localStorage.setItem("app_lang", lang);
    updateSliderVisual(lang);
    applyDOMTranslations(lang);
  }

  function initLangSystem() {
    const saved = localStorage.getItem("app_lang") || "en";
    updateSliderVisual(saved);
    applyDOMTranslations(saved);

    const btnEn = document.getElementById("btn-lang-en");
    const btnTr = document.getElementById("btn-lang-tr");

    if (btnEn) {
      btnEn.onclick = (e) => {
        e.preventDefault();
        setLanguage("en");
      };
    }

    if (btnTr) {
      btnTr.onclick = (e) => {
        e.preventDefault();
        setLanguage("tr");
      };
    }
  }

  // Hem ilk açılışta hem Astro sayfa geçişlerinde anında çalıştır
  initLangSystem();
  document.addEventListener("astro:after-swap", initLangSystem);
  document.addEventListener("astro:page-load", initLangSystem);
</script>