---
// src/components/ZuzuMascot.astro
---

<div 
  id="zuzu-container" 
  class="fixed z-50 select-none cursor-pointer pointer-events-none will-change-[transform,top,left]"
  title="Zuzu'yu sevmek için tıkla!"
>
  <!-- Tıklayınca Çıkan Balon -->
  <div 
    id="zuzu-bubble" 
    class="opacity-0 transition-opacity duration-200 absolute -top-8 left-1/2 -translate-x-1/2 bg-skin-card border border-skin-line text-skin-base text-[11px] font-mono px-2 py-1 rounded shadow whitespace-nowrap pointer-events-none"
  >
    Miyav! 🐾
  </div>

  <!-- Piksel Kedi (Mobilde w-14, Masaüstünde md:w-24) -->
  <img 
    id="zuzu-cat"
    src="/zuzu.png" 
    alt="Zuzu" 
    class="w-14 h-14 md:w-24 md:h-24 object-contain image-rendering-pixelated drop-shadow-lg pointer-events-auto transition-transform duration-150"
  />
</div>

<style>
  .image-rendering-pixelated {
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .walking {
    animation: zuzu-bounce 0.18s infinite alternate ease-in-out;
  }

  @keyframes zuzu-bounce {
    0% { transform: translateY(0) scaleY(1); }
    100% { transform: translateY(-6px) scaleY(0.96); }
  }

  .facing-left {
    transform: scaleX(-1);
  }
</style>

<script is:inline>
  const container = document.getElementById("zuzu-container");
  const cat = document.getElementById("zuzu-cat");
  const bubble = document.getElementById("zuzu-bubble");

  // Dokunmatik ekran kontrolü
  const isTouchDevice = () => window.matchMedia("(pointer: coarse)").matches || window.innerWidth < 768;

  if (!isTouchDevice()) {
    /* =========================================
       MASAÜSTÜ: 2D MOUSE KOVALAMA MODU
       ========================================= */
    let mouseX = window.innerWidth * 0.8;
    let mouseY = window.innerHeight * 0.8;
    let catX = mouseX;
    let catY = mouseY;
    let isWalking = false;

    window.addEventListener("mousemove", function (e) {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    function followMouse() {
      if (container && cat) {
        const targetX = mouseX - 48;
        const targetY = mouseY - 48;
        const dx = targetX - catX;
        const dy = targetY - catY;
        const distance = Math.hypot(dx, dy);

        if (distance > 35) {
          catX += dx * 0.045;
          catY += dy * 0.045;

          if (dx < -2) cat.classList.add("facing-left");
          else if (dx > 2) cat.classList.remove("facing-left");

          if (!isWalking) {
            cat.classList.add("walking");
            isWalking = true;
          }
        } else {
          if (isWalking) {
            cat.classList.remove("walking");
            isWalking = false;
          }
        }

        container.style.left = catX + "px";
        container.style.top = catY + "px";
      }
      requestAnimationFrame(followMouse);
    }
    requestAnimationFrame(followMouse);

  } else {
    /* =========================================
       MOBİL: ALT KISIMDA AKILLI DEVRİYE MODU
       ========================================= */
    let currentX = 20;
    let targetX = 20;
    let isMoving = false;
    let direction = 1;
    let speed = 1.1;

    container.style.top = "auto";
    container.style.bottom = "12px";
    container.style.left = "20px";

    function pickMobileTarget() {
      const screenWidth = window.innerWidth;
      const padding = 20;
      targetX = Math.random() * (screenWidth - padding * 2 - 56) + padding;
      direction = targetX > currentX ? 1 : -1;

      if (direction === -1) cat.classList.add("facing-left");
      else cat.classList.remove("facing-left");

      isMoving = true;
      cat.classList.add("walking");
    }

    function patrolMobile() {
      if (isMoving && container) {
        const distance = targetX - currentX;
        if (Math.abs(distance) < speed) {
          currentX = targetX;
          isMoving = false;
          cat.classList.remove("walking");
          setTimeout(pickMobileTarget, Math.random() * 3000 + 2000);
        } else {
          currentX += direction * speed;
        }
        container.style.left = currentX + "px";
      }
      requestAnimationFrame(patrolMobile);
    }

    setTimeout(pickMobileTarget, 800);
    patrolMobile();
  }

  // Tıklanınca / Dokununca Miyavlasın
  if (cat && bubble) {
    const speak = function (e) {
      e.stopPropagation();
      bubble.classList.remove("opacity-0");
      setTimeout(() => bubble.classList.add("opacity-0"), 1500);
    };
    cat.addEventListener("click", speak);
    cat.addEventListener("touchstart", speak, { passive: true });
  }
</script>