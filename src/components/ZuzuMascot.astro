---
// src/components/ZuzuMascot.astro
---

<div 
  id="zuzu-container" 
  class="fixed z-50 select-none cursor-pointer pointer-events-none will-change-[transform,top,left]"
  style="bottom: 24px; right: 24px;"
  title="Zuzu'yu sevmek ve peşine takmak için tıkla!"
>
  <!-- Konuşma Balonu -->
  <div 
    id="zuzu-bubble" 
    class="opacity-0 transition-opacity duration-200 absolute -top-8 left-1/2 -translate-x-1/2 bg-skin-card border border-skin-line text-skin-base text-[11px] font-mono px-2 py-1 rounded shadow whitespace-nowrap pointer-events-none"
  >
    Miyav! Takipteyim 🐾
  </div>

  <!-- Piksel Kedi -->
  <img 
    id="zuzu-cat"
    src="/zuzu.png" 
    alt="Zuzu" 
    class="w-14 h-14 md:w-20 md:h-20 object-contain image-rendering-pixelated drop-shadow-lg pointer-events-auto transition-transform duration-150 hover:scale-110"
  />
</div>

<style>
  .image-rendering-pixelated {
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .walking {
    animation: zuzu-bounce 0.2s infinite alternate ease-in-out;
  }

  @keyframes zuzu-bounce {
    0% { transform: translateY(0); }
    100% { transform: translateY(-5px); }
  }

  .facing-left {
    transform: scaleX(-1);
  }
</style>

<script is:inline>
  const container = document.getElementById("zuzu-container");
  const cat = document.getElementById("zuzu-cat");
  const bubble = document.getElementById("zuzu-bubble");

  let isFollowing = false;
  let mouseX = window.innerWidth - 80;
  let mouseY = window.innerHeight - 80;
  let catX = mouseX;
  let catY = mouseY;
  let isWalking = false;

  window.addEventListener("mousemove", function (e) {
    mouseX = e.clientX;
    mouseY = e.clientY;
  });

  function followLoop() {
    if (isFollowing && container && cat) {
      // Mouse'a çok yapışmasın diye 120px güvenli mesafe sınırı
      const targetX = mouseX - 40;
      const targetY = mouseY - 40;

      const dx = targetX - catX;
      const dy = targetY - catY;
      const distance = Math.hypot(dx, dy);

      if (distance > 120) {
        catX += dx * 0.035; // Yumuşak ve sakin takip hızı
        catY += dy * 0.035;

        if (dx < -2) cat.classList.add("facing-left");
        else if (dx > 2) cat.classList.remove("facing-left");

        if (!isWalking) {
          cat.classList.add("walking");
          isWalking = true;
        }
      } else {
        if (isWalking) {
          cat.classList.remove("walking");
          isWalking = false;
        }
      }

      container.style.left = catX + "px";
      container.style.top = catY + "px";
      container.style.bottom = "auto";
      container.style.right = "auto";
    }
    requestAnimationFrame(followLoop);
  }

  requestAnimationFrame(followLoop);

  // Kediyi sevince (tıklayınca) modu aç/kapat
  if (cat && bubble) {
    cat.addEventListener("click", function (e) {
      e.stopPropagation();
      isFollowing = !isFollowing;

      if (isFollowing) {
        // Takip moduna geçerken konumu sabitle
        const rect = container.getBoundingClientRect();
        catX = rect.left;
        catY = rect.top;
        bubble.textContent = "Miyav! Peşindeyim 🐾";
      } else {
        // Takibi bırakıp dinlenme modu
        cat.classList.remove("walking");
        isWalking = false;
        bubble.textContent = "Dinleniyorum... 💤";
      }

      bubble.classList.remove("opacity-0");
      setTimeout(function () {
        bubble.classList.add("opacity-0");
      }, 1600);
    });
  }
</script>