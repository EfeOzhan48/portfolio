---
// src/components/ZuzuMascot.astro
---

<div 
  id="zuzu-wrapper" 
  class="fixed bottom-4 right-4 z-50 select-none cursor-pointer group"
  title="Zuzu'yu sevmek için tıkla!"
>
  <div 
    id="zuzu-bubble" 
    class="opacity-0 transition-opacity duration-200 absolute -top-8 right-0 bg-skin-card border border-skin-line text-skin-base text-[11px] font-mono px-2 py-1 rounded shadow whitespace-nowrap pointer-events-none"
  >
    Miyav! 🐾
  </div>

  <img 
    id="zuzu-img"
    src="/zuzu.jpeg" 
    alt="Zuzu" 
    class="w-14 h-14 object-contain image-rendering-pixelated drop-shadow-md transition-transform duration-200 hover:scale-110"
  />
</div>

<style>
  .image-rendering-pixelated {
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .walking {
    animation: zuzu-walk 0.2s infinite alternate ease-in-out;
  }

  @keyframes zuzu-walk {
    0% {
      transform: translateY(0) rotate(0deg);
    }
    100% {
      transform: translateY(-5px) rotate(4deg);
    }
  }
</style>

<script is:inline>
  const zuzu = document.getElementById("zuzu-img");
  const bubble = document.getElementById("zuzu-bubble");
  let scrollTimeout;

  window.addEventListener("scroll", function () {
    if (zuzu) {
      zuzu.classList.add("walking");
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(function () {
        zuzu.classList.remove("walking");
      }, 150);
    }
  });

  if (zuzu && bubble) {
    zuzu.addEventListener("click", function () {
      bubble.classList.remove("opacity-0");
      setTimeout(function () {
        bubble.classList.add("opacity-0");
      }, 1500);
    });
  }
</script>