---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  // 'thoughts' etiketini hariç tutarak sadece projeleri alıyoruz
  const posts = await getCollection("posts", ({ data }) => {
    const isDraft = Boolean(data.draft);
    const isThought = data.tags?.some((tag: string) =>
      tag.toLowerCase().includes("thought")
    );
    return !isDraft && !isThought;
  });

  const sortedPosts = getSortedPosts(posts);

  return paginate(sortedPosts, { pageSize: config.posts.perPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout title={`Projects | ${config.site.title}`}>
  <Header activeNav="posts" />
  <main id="main-content" class="app-layout mx-auto w-full max-w-app px-4 pb-12">
    <section class="pt-8 pb-4">
      <h1 class="text-3xl font-bold tracking-tight">Projects</h1>
      <p class="mt-2 text-muted-foreground">All the projects and open-source works.</p>
    </section>

    <ul class="mt-6">
      {page.data.map(post => <Card {...post} />)}
    </ul>
  </main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>