---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1 mx-auto w-full max-w-app px-4"
  >
    <!-- 1. HERO BÖLÜMÜ -->
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Hey, I'm Durmuş Efe Özhan 👋
      </h1>
      
      <p class="text-lg text-muted-foreground mt-2">
        Welcome to my personal digital devlog where I document my engineering journey, experiments, and open-source projects.
      </p>

      {
        socials.length > 0 && (
          <div class="mt-6 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap font-semibold sm:mb-0">
              Social Links:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <!-- 2. FEATURED POSTS -->
    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            Featured
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <!-- 3. RECENT POSTS -->
    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            Recent Posts
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <!-- 4. ALL POSTS BUTONU -->
    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180 ms-1" />
      </LinkButton>
    </div>

    <!-- 5. GET IN TOUCH (SAYFANIN EN ALTINDA) -->
    <section id="contact" class="border-border border-t pt-12 pb-12">
      <h2 class="text-3xl font-bold text-center tracking-tight mb-8 text-accent">
        Get In Touch
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
        <!-- Sol Taraf: İletişim Bilgileri -->
        <div class="md:col-span-5 flex flex-col gap-4">
          <!-- Email -->
          <a 
            href="mailto:ozhanefe33@gmail.com" 
            class="flex items-center gap-3.5 group p-3 rounded-xl border border-border bg-muted/20 hover:border-[var(--accent-purple,#c084fc)] hover:bg-muted/40 transition-all duration-150"
          >
            <div class="w-10 h-10 rounded-lg bg-background border border-border flex items-center justify-center group-hover:border-[var(--accent-purple,#c084fc)] transition-colors shrink-0">
              <svg class="w-4 h-4 stroke-accent group-hover:stroke-[var(--accent-purple,#c084fc)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="overflow-hidden">
              <div class="text-[11px] uppercase font-semibold text-muted-foreground">Email</div>
              <div class="text-xs font-medium text-foreground group-hover:text-[var(--accent-purple,#c084fc)] transition-colors truncate">ozhanefe33@gmail.com</div>
            </div>
          </a>

          <!-- LinkedIn -->
          <a 
            href="https://www.linkedin.com/in/durmuş-efe-özhan-0719a4323/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex items-center gap-3.5 group p-3 rounded-xl border border-border bg-muted/20 hover:border-[var(--accent-purple,#c084fc)] hover:bg-muted/40 transition-all duration-150"
          >
            <div class="w-10 h-10 rounded-lg bg-background border border-border flex items-center justify-center group-hover:border-[var(--accent-purple,#c084fc)] transition-colors shrink-0">
              <svg class="w-4 h-4 stroke-accent group-hover:stroke-[var(--accent-purple,#c084fc)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zM4 6a2 2 0 100-4 2 2 0 000 4z" />
              </svg>
            </div>
            <div>
              <div class="text-[11px] uppercase font-semibold text-muted-foreground">LinkedIn</div>
              <div class="text-xs font-medium text-foreground group-hover:text-[var(--accent-purple,#c084fc)] transition-colors">Durmuş Efe Özhan</div>
            </div>
          </a>

          <!-- Location -->
          <div class="flex items-center gap-3.5 p-3 rounded-xl border border-border bg-muted/20">
            <div class="w-10 h-10 rounded-lg bg-background border border-border flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 stroke-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <div class="text-[11px] uppercase font-semibold text-muted-foreground">Location</div>
              <div class="text-xs font-medium text-foreground">Samsun / Muğla, Turkey</div>
            </div>
          </div>
        </div>

        <!-- Sağ Taraf: Form Kartı -->
        <div class="md:col-span-7 bg-muted/30 p-5 sm:p-6 rounded-2xl border border-border shadow-md relative">
          <!-- Başarı Bildirim Kartı (İngilizce) -->
          <div 
            id="form-success-message" 
            class="hidden flex-col items-center justify-center text-center p-6 py-10 bg-background/90 rounded-xl border border-[var(--accent-purple,#c084fc)] animate-fade-in"
          >
            <div class="w-12 h-12 rounded-full bg-[var(--accent-purple,#c084fc)]/20 text-[var(--accent-purple,#c084fc)] flex items-center justify-center mb-3">
              <svg class="w-6 h-6 stroke-[var(--accent-purple,#c084fc)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-foreground">Message Sent! 🎉</h3>
            <p class="text-xs text-muted-foreground mt-1 max-w-xs">
              Thank you for reaching out. I'll get back to you as soon as possible.
            </p>
            <button 
              id="send-another-btn" 
              type="button" 
              class="mt-5 text-xs text-accent hover:text-[var(--accent-purple,#c084fc)] underline uppercase tracking-wider font-semibold cursor-pointer"
            >
              Send Another Message
            </button>
          </div>

          <!-- İletişim Formu -->
          <form 
            id="contact-form"
            action="https://formspree.io/f/xgawgjbk" 
            method="POST" 
            class="flex flex-col gap-3.5"
          >
            <!-- Gmail Başlığı -->
            <input type="hidden" name="_subject" value="🚀 New message from efeozhan.dev!" />

            <div>
              <label for="name" class="block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground mb-1">Your Name</label>
              <input 
                type="text" 
                name="name" 
                id="name" 
                placeholder="Your Name" 
                required
                class="w-full px-3.5 py-2 rounded-lg bg-background border border-border focus:outline-none focus:border-[var(--accent-purple,#c084fc)] text-sm text-foreground transition-colors placeholder:text-muted-foreground/60"
              />
            </div>

            <div>
              <label for="email" class="block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground mb-1">Your Email</label>
              <input 
                type="email" 
                name="email" 
                id="email" 
                placeholder="Your Email" 
                required
                class="w-full px-3.5 py-2 rounded-lg bg-background border border-border focus:outline-none focus:border-[var(--accent-purple,#c084fc)] text-sm text-foreground transition-colors placeholder:text-muted-foreground/60"
              />
            </div>

            <div>
              <label for="message" class="block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground mb-1">Your Message</label>
              <textarea 
                name="message" 
                id="message" 
                rows="3" 
                placeholder="Your Message" 
                required
                class="w-full px-3.5 py-2 rounded-lg bg-background border border-border focus:outline-none focus:border-[var(--accent-purple,#c084fc)] text-sm text-foreground transition-colors resize-none placeholder:text-muted-foreground/60"
              ></textarea>
            </div>

            <button 
              id="submit-btn"
              type="submit" 
              class="group mt-1 w-full sm:w-auto self-start flex items-center justify-center gap-2 bg-accent text-accent-foreground px-5 py-2.5 rounded-lg font-semibold text-xs tracking-wider uppercase hover:!bg-[var(--accent-purple,#c084fc)] active:scale-95 transition-all shadow cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <span id="btn-text" class="group-hover:!text-white transition-colors">SEND MESSAGE</span>
              <svg id="btn-icon" class="w-3.5 h-3.5 stroke-current group-hover:!stroke-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  function setupContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const successBox = document.getElementById("form-success-message");
    const sendAnotherBtn = document.getElementById("send-another-btn");
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
    const btnText = document.getElementById("btn-text");

    if (!form || !successBox || !submitBtn || !btnText) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      
      submitBtn.disabled = true;
      btnText.textContent = "SENDING...";

      const formData = new FormData(form);

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: {
            "Accept": "application/json"
          }
        });

        if (response.ok) {
          form.reset();
          form.classList.add("hidden");
          successBox.classList.remove("hidden");
          successBox.classList.add("flex");
        } else {
          alert("Something went wrong while sending the message. Please try again.");
        }
      } catch (err) {
        alert("Network error. Please check your internet connection.");
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = "SEND MESSAGE";
      }
    });

    sendAnotherBtn?.addEventListener("click", () => {
      successBox.classList.add("hidden");
      successBox.classList.remove("flex");
      form.classList.remove("hidden");
    });
  }

  document.addEventListener("astro:page-load", () => {
    setupContactForm();
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>