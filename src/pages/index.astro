---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Socials from "@/components/Socials.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "../../astro-paper.config";

const rawPosts = await getCollection("posts");
const posts = rawPosts.filter(post => Boolean(post?.data?.title));

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-app px-4 pb-4">
    <section id="hero" class="pb-6 pt-8">
      <h1 class="my-4 inline-block text-3xl font-bold sm:my-8 sm:text-5xl">
        Hey, I'm {config.site.author} 👋
      </h1>
      <p class="my-4">
        {config.site.description}
      </p>
      <div class="social-wrapper my-4 flex flex-col sm:flex-row sm:items-center">
        <div class="social-links mb-1 mr-2 whitespace-nowrap font-semibold sm:mb-0">
          Social Links:
        </div>
        <Socials />
      </div>
    </section>

    <hr class="my-6 border-dashed border-skin-line" />

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pb-6 pt-12">
          <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
          <ul>
            {featuredPosts.map(post => (
              <Card {...post} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pb-6 pt-12">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (post, index) =>
                index < config.posts.perIndex && (
                  <Card {...post} />
                )
            )}
          </ul>
        </section>
      )
    }

    <div class="all-posts-btn-wrapper my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <svg xmlns="http://www.w3.org/2000/svg" class="inline-block h-6 w-6">
          <path
            d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
          ></path>
        </svg>
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>