---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import config from "@/config";

const posts = await getCollection("posts");
const tags = getUniqueTags(posts);
---

<Layout title={`Tags | ${config.site.title}`}>
  <Header activeNav="tags" />
  <main id="main-content" class="app-layout my-1 mx-auto w-full max-w-app px-4 pb-12 pt-8">
    <h1 class="text-2xl font-bold tracking-wide sm:text-3xl text-accent mb-6">
      Tags
    </h1>
    <p class="text-muted-foreground mb-6 text-sm">
      All topics and technologies covered across devlogs:
    </p>
    <ul class="flex flex-wrap gap-3">
      {tags.map(({ tag, tagName }) => <Tag tag={tag} tagName={tagName} size="lg" />)}
    </ul>
  </main>
  <Footer />
</Layout>