---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Hey, I'm Efe.
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p class="text-lg">
        Welcome to my personal digital devlog where I document my engineering journey, experiments, and open-source projects.
      </p>

      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              Social Links:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            Featured
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            Recent Posts
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>

    <!-- Get In Touch Section (Görseldeki İki Sütunlu Kart Tasarımı) -->
    <section id="contact" class="border-border border-t pt-12 pb-8">
      <h2 class="text-3xl font-bold text-center tracking-tight mb-8">
        Get In Touch
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
        <!-- Sol Taraf: İletişim Bilgileri -->
        <div class="md:col-span-5 flex flex-col gap-6 pt-2">
          <!-- Email -->
          <a 
            href="mailto:ozhanefe33@gmail.com" 
            class="flex items-center gap-4 group p-2 rounded-lg hover:bg-skin-card transition-colors"
          >
            <div class="w-12 h-12 rounded-full bg-skin-card border border-skin-line flex items-center justify-center group-hover:border-skin-accent transition-colors shrink-0">
              <svg class="w-5 h-5 stroke-skin-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <div class="text-xs uppercase font-semibold text-skin-base/60">Email</div>
              <div class="text-sm font-medium text-skin-base group-hover:text-skin-accent transition-colors">ozhanefe33@gmail.com</div>
            </div>
          </a>

          <!-- LinkedIn -->
          <a 
            href="https://www.linkedin.com/in/durmuş-efe-özhan-0719a4323/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center gap-4 group p-2 rounded-lg hover:bg-skin-card transition-colors"
          >
            <div class="w-12 h-12 rounded-full bg-skin-card border border-skin-line flex items-center justify-center group-hover:border-skin-accent transition-colors shrink-0">
              <svg class="w-5 h-5 stroke-skin-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zM4 6a2 2 0 100-4 2 2 0 000 4z" />
              </svg>
            </div>
            <div>
              <div class="text-xs uppercase font-semibold text-skin-base/60">LinkedIn</div>
              <div class="text-sm font-medium text-skin-base group-hover:text-skin-accent transition-colors">Durmuş Efe Özhan</div>
            </div>
          </a>

          <!-- Location -->
          <div class="flex items-center gap-4 p-2">
            <div class="w-12 h-12 rounded-full bg-skin-card border border-skin-line flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 stroke-skin-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <div class="text-xs uppercase font-semibold text-skin-base/60">Location</div>
              <div class="text-sm font-medium text-skin-base">Samsun / Muğla, Turkey</div>
            </div>
          </div>
        </div>

        <!-- Sağ Taraf: Form Kartı -->
        <div class="md:col-span-7 bg-skin-card p-6 sm:p-8 rounded-2xl border border-skin-line shadow-xl">
          <form 
            action="https://formspree.io/f/xbjnyzqw" 
            method="POST" 
            class="flex flex-col gap-4"
          >
            <div>
              <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-skin-base/80 mb-1.5">Your Name</label>
              <input 
                type="text" 
                name="name" 
                id="name" 
                placeholder="Your Name" 
                required
                class="w-full px-4 py-2.5 rounded-lg bg-skin-fill border border-skin-line focus:outline-none focus:border-skin-accent text-sm text-skin-base transition-colors"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-skin-base/80 mb-1.5">Your Email</label>
              <input 
                type="email" 
                name="email" 
                id="email" 
                placeholder="Your Email" 
                required
                class="w-full px-4 py-2.5 rounded-lg bg-skin-fill border border-skin-line focus:outline-none focus:border-skin-accent text-sm text-skin-base transition-colors"
              />
            </div>

            <div>
              <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-skin-base/80 mb-1.5">Your Message</label>
              <textarea 
                name="message" 
                id="message" 
                rows="4" 
                placeholder="Your Message" 
                required
                class="w-full px-4 py-2.5 rounded-lg bg-skin-fill border border-skin-line focus:outline-none focus:border-skin-accent text-sm text-skin-base transition-colors resize-none"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="mt-2 w-full sm:w-auto self-start flex items-center justify-center gap-2 bg-skin-accent text-skin-inverted px-6 py-2.5 rounded-lg font-semibold text-xs tracking-wider uppercase hover:opacity-90 active:scale-95 transition-all shadow-md"
            >
              <span>SEND MESSAGE</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>